# Copy to .env.local for local testing with `vercel dev`.
# NEVER commit the real .env.local, and never put these values in
# any file the browser downloads (html, script.js, style.css).
#
# On Vercel these same three go in:
#   Project -> Settings -> Environment Variables

# The Gmail / Google Workspace account that sends the mail
SMTP_USER=hello@healthcareplus.in

# A Google App Password, 16 characters, NOT your normal password.
# Needs 2-Step Verification switched on first:
#   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where contact form messages should arrive.
# Leave it out and they go to SMTP_USER.
CONTACT_TO=hello@healthcareplus.in

# Optional: any other SMTP provider. Defaults to smtp.gmail.com:465.
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
